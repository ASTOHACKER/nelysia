{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist-package",
    "rootDir": ".",
    "rewriteRelativeImportExtensions": true,
    "noEmitOnError": true
  },
  "include": ["packages/**/*.ts"]
}
