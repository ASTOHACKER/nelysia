{
  "name": "@narudom96/nelysia",
  "version": "0.5.0",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "description": "Compiler-first TypeScript backend framework for Bun, Node.js, and Web Standards",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ASTOHACKER/nelysia.git"
  },
  "keywords": [
    "framework",
    "backend",
    "typescript",
    "bun",
    "node",
    "compiler-first",
    "openapi",
    "websocket",
    "edge",
    "serverless"
  ],
  "scripts": {
    "test": "node --experimental-strip-types --test tests/**/*.test.ts",
    "example": "node --experimental-strip-types examples/hello/index.ts",
    "bun:example": "bun run examples/hello/bun.ts",
    "bun:smoke": "bun run examples/hello/bun-smoke.ts",
    "benchmark": "node --experimental-strip-types benchmarks/run.ts",
    "benchmark:bun": "bun run benchmarks/run-bun.ts",
    "benchmark:oha": "node --experimental-strip-types benchmarks/run-oha.ts",
    "benchmark:oha:bun": "BENCH_SUITE=bun node --experimental-strip-types benchmarks/run-oha.ts",
    "benchmark:oha:node": "BENCH_SUITE=node node --experimental-strip-types benchmarks/run-oha.ts",
    "benchmark:oha:release": "BENCH_PORT=4370 BENCH_DURATION_SEC=30 BENCH_CONCURRENCY=50 BENCH_ROUNDS=7 node --experimental-strip-types benchmarks/run-oha.ts",
    "benchmark:jwt": "bun run benchmarks/run-jwt.ts",
    "benchmark:jwt:release": "BENCH_PORT=4385 BENCH_DURATION_SEC=30 BENCH_CONCURRENCY=50 BENCH_ROUNDS=7 bun run benchmarks/run-jwt.ts",
    "benchmark:teb": "bun run benchmarks/run-techempower.ts",
    "benchmark:teb:verify": "bun run benchmarks/verify-techempower.ts",
    "benchmark:teb:bundle": "bun run benchmarks/prepare-teb-bundle.ts",
    "soak": "node --experimental-strip-types benchmarks/soak.ts",
    "soak:1m": "SOAK_REQUESTS=1000000 node --experimental-strip-types benchmarks/soak.ts",
    "soak:10m": "SOAK_REQUESTS=10000000 node --experimental-strip-types benchmarks/soak.ts",
    "soak:24h": "SOAK_DURATION_MS=86400000 node --experimental-strip-types benchmarks/soak.ts",
    "soak:gate": "npm run soak:1m && npm run soak:10m",
    "prisma:generate": "prisma generate --schema examples/prisma/schema.prisma",
    "prisma:smoke": "npm run prisma:generate && DATABASE_URL=file:./smoke.db prisma db push --schema examples/prisma/schema.prisma --skip-generate && DATABASE_URL=file:./smoke.db node --experimental-strip-types examples/prisma/smoke.ts",
    "deno:check": "deno check examples/deno/main.ts",
    "deployment:smoke": "node scripts/check-deployments.mjs",
    "package:imports": "node scripts/check-package-imports.mjs",
    "framework:check": "node scripts/check-framework-fixtures.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "release:check": "npm run typecheck && npm test && bun test && npm run package:build && npm run package:imports && npm run soak && npm run deno:check && npm run docs:check && npm audit --omit=dev && git diff --check",
    "release:check:v05": "npm run typecheck && npm test && bun test && npm run package:build && npm run package:imports && npm run deployment:smoke && npm run soak:gate && npm run deno:check && npm run docs:check && npm audit --omit=dev && git diff --check",
    "inspect": "node --experimental-strip-types packages/cli/src/index.ts inspect",
    "build": "node --experimental-strip-types packages/cli/src/index.ts build",
    "package:build": "tsc -p tsconfig.build.json",
    "prepack": "npm run package:build",
    "prepare": "npm run package:build",
    "typecheck": "tsc --noEmit"
  },
  "bin": {
    "nelysia": "dist-package/packages/cli/src/index.js"
  },
  "files": [
    "dist-package",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./dist-package/packages/core/src/index.js",
    "./plugins": "./dist-package/packages/plugins/src/index.js",
    "./observability": "./dist-package/packages/observability/src/index.js",
    "./runtime-fetch": "./dist-package/packages/runtime-fetch/src/server.js",
    "./runtime-node": "./dist-package/packages/runtime-node/src/server.js",
    "./runtime-bun": "./dist-package/packages/runtime-bun/src/server.js",
    "./runtime-node-cluster": "./dist-package/packages/runtime-node/src/cluster.js",
    "./graphql": "./dist-package/packages/integrations-graphql/src/index.js",
    "./drizzle": "./dist-package/packages/integrations-drizzle/src/index.js",
    "./prisma": "./dist-package/packages/integrations-prisma/src/index.js",
    "./better-auth": "./dist-package/packages/integrations-better-auth/src/index.js",
    "./runtime-vercel": "./dist-package/packages/runtime-vercel/src/index.js",
    "./runtime-cloudflare": "./dist-package/packages/runtime-cloudflare/src/index.js",
    "./compiler": "./dist-package/packages/compiler/src/index.js",
    "./openapi": "./dist-package/packages/openapi/src/index.js",
    "./jwt": "./dist-package/packages/jwt/src/index.js",
    "./client": "./dist-package/packages/client/src/index.js",
    "./upload": "./dist-package/packages/upload/src/index.js",
    "./logger": "./dist-package/packages/logger/src/index.js",
    "./timeout": "./dist-package/packages/timeout/src/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@elysiajs/jwt": "^1.4.2",
    "@prisma/client": "^6.12.0",
    "@tanstack/react-router": "^1.170.36",
    "@tanstack/react-start": "^1.168.53",
    "@types/better-sqlite3": "^9.6.0",
    "@types/bun": "^1.4.2",
    "@types/node": "^22.20.2",
    "@types/ws": "^8.18.1",
    "better-auth": "^1.7.4",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.45.2",
    "elysia": "^2.0.0-exp.60",
    "exact-mirror": "^1.2.6",
    "express": "^5.2.1",
    "fastify": "^5.12.4",
    "h3": "^2.0.1-rc.31",
    "hono": "^4.13.7",
    "openapi-types": "^12.1.3",
    "prisma": "^6.12.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typebox": "^1.3.30",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "graphql": "^17.0.2",
    "ws": "^8.21.3"
  },
  "peerDependencies": {
    "@prisma/client": "^6.12.0",
    "better-auth": "^1.7.4",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.45.2"
  },
  "peerDependenciesMeta": {
    "@prisma/client": {
      "optional": true
    },
    "better-auth": {
      "optional": true
    },
    "better-sqlite3": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    }
  },
  "allowScripts": {
    "file:.deno/better-sqlite3@12.11.1/node_modules/better-sqlite3": true,
    "file:../../better-sqlite3@12.11.1/node_modules/better-sqlite3": true
  }
}
